.npm/
.pnpm-store/
.cache/
.vercel/
.netlify/

# test coverage
coverage/

# OS files
.DS_Store
Thumbs.db

# editor folders
.idea/

# binary assets (no value as text context)
*.woff
*.woff2
*.ttf
*.otf
*.eot
*.ico
