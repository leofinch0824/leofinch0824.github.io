---
import { Image } from 'astro:assets';
import Base from './Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { AUTHOR_EMAIL, POST_LICENSE, SITE_AUTHOR } from '../consts';
import type { BlogPost as BlogPostEntry } from '../utils/posts';

interface Props {
	/** 内容条目本体：头图、分类、标签等版面数据都从它来 */
	post: BlogPostEntry;
	/** 底片编号 № NNN —— [...slug].astro 按集合排序算出，不进 frontmatter */
	no: string;
	/** 阅读时长（分钟），构建时由 readingMinutes 估出 */
	minutes: number;
	/** 排序序列上更新的一篇；首篇为 undefined → 对应翻页卡省略 */
	newer?: BlogPostEntry;
	newerNo?: string;
	/** 排序序列上更早的一篇；末篇为 undefined → 对应翻页卡省略 */
	older?: BlogPostEntry;
	olderNo?: string;
}

const { post, no, minutes, newer, newerNo, older, olderNo } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, category, tags } = post.data;
// 元信息行第三段：分类 / 标签，形态如「算法 / 数据结构」
const metaTopic = [category, ...(tags ?? [])].join(' / ');
// 版权声明卡用：与 BaseHead 的 canonical 同源（Astro.site + 当前路径）
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<Base title={title} description={description} lang="zh-CN">
	<style>
		/* 过渡兜底解除（同首页/归档，批3 的做法）：global.css 末尾暂留的 main{width:720px}
		   是给旧版文章页的居中列用的；新版面交给 .article-col / .prose。只写布局。 */
		main {
			width: auto;
			max-width: none;
			margin: 0;
			padding: 0;
		}
	</style>
	<main id="content">
		<article class="article">
			<section class="article-head" data-od-id="article-head">
				<div class="container article-col">
					<p class="eyebrow eyebrow-lead">{category} · № {no}</p>
					<h1>{title}</h1>
					<p class="lead">{description}</p>
					<div class="article-meta">
						<span class="meta num"><FormattedDate date={pubDate} /></span>
						<span class="meta">约 {minutes} 分钟</span>
						<span class="meta">{metaTopic}</span>
						{
							updatedDate && (
								<span class="meta">
									更新于 <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>
				</div>
			</section>

			<section class="section" style="padding-top:0" data-od-id="article-body">
				<div class="container article-col">
					{
						heroImage && (
							<figure class="plate">
								<div class="plate-inner">
									{/* 印刷边框头图：layout="none" 只给 width（高度自动）——
									    内容图永不裁切（AGENTS.md / DESIGN.md 硬约束）。
									    alt 留空：占位照片不承载文章语义，标题就在上方
									    （与批3 PostCard 的同一决策）。 */}
									<Image
										class="plate-img"
										src={heroImage}
										alt=""
										width={1100}
										layout="none"
										loading="eager"
										fetchpriority="high"
										decoding="async"
									/>
								</div>
								<figcaption>占位配图 · 待作者提供正式照片</figcaption>
							</figure>
						)
					}

					<div class="prose">
						<slot />
					</div>

					{/* 版权声明（2026-10-05 所有者拍板：CC BY-NC-SA 4.0）：
					    正文读完、翻页之前的收束相纸卡。事实全部来自 consts.ts 单一来源。 */}
					<aside class="license" aria-label="版权声明">
						<p class="license-label">版权声明</p>
						<p class="license-body">
							本文采用
							<a rel="license" href={POST_LICENSE.url}>{POST_LICENSE.name}</a>
							许可协议：署名、非商业性使用、相同方式共享——转载请保留本文链接与作者署名，二次创作须以相同协议共享；商业转载请先
							<a href={`mailto:${AUTHOR_EMAIL}`}>联系作者</a>。
						</p>
						<p class="license-fine meta num">
							作者 {SITE_AUTHOR} · 本文链接 <a href={canonicalURL.href}>{canonicalURL.href}</a>
						</p>
					</aside>

					{
						(newer || older) && (
							<nav class="page-turn" aria-label="相邻文章">
								{newer && (
									<a class="turn" href={`/blog/${newer.id}/`}>
										<span class="turn-label">← 更新的一张 · № {newerNo}</span>
										<span class="turn-title">{newer.data.title}</span>
									</a>
								)}
								{older && (
									<a class="turn turn-next" href={`/blog/${older.id}/`}>
										<span class="turn-label">更早的一张 · № {olderNo} →</span>
										<span class="turn-title">{older.data.title}</span>
									</a>
								)}
							</nav>
						)
					}
				</div>
			</section>
		</article>
	</main>
</Base>
