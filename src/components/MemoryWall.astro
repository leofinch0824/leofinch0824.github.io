---
import PostCard from './PostCard.astro';
import type { WallCard } from '../utils/posts';

interface Props {
	/** 橱窗卡片（index.astro 已按 WALL_LIMIT 截取最近这些张，docs/pagination-design.md） */
	cards: WallCard[];
}

const { cards } = Astro.props;
---

<section class="section" data-od-id="wall">
	<div class="container">
		<div class="wall-head">
			<h2>最近回忆录</h2>
			<a class="btn btn-ghost btn-arrow" href="/blog">打开整本相册</a>
		</div>
		<div class="wall" id="wall-items">
			{cards.map((card) => (
				<PostCard post={card} rot={card.rot} index={card.i} />
			))}
		</div>
	</div>
</section>

<style>
	/* 只写布局（原 .wall-hint 规则随提示行一并移除，设计精修 #4；
	   年份过滤脚本随分页改造移除，docs/pagination-design.md——墙是橱窗，
	   全量翻阅走归档按年路由）。 */
</style>
