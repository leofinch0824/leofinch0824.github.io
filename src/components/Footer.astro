---
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';

// 页脚（批2，对照 reference/prototype/home.tpl.html:262-284 的 .pagefoot / .foot-grid）。
// 列结构与参考页一致：站点名 + 说明 / 「走一走」/「订阅」两列。
// 链接全部指向真实路由：「文章样本」取构建时最新一篇文章；
// RSS 指向 /rss.xml（真链接）；「邮件通知」保持占位 —— 真实订阅服务未决
// （PRODUCT.md「明确未决」，不得虚构）。
const posts = await getCollection('blog');
const latest = [...posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];
---

<footer class="pagefoot" data-od-id="footer">
	<div class="container">
		<div class="foot-grid">
			<div>
				<p class="foot-name">{SITE_TITLE}</p>
				<p class="foot-note">用 Astro 构建的纯静态站点，文章、分类与图片都在构建时生成。</p>
			</div>
			<div class="foot-col">
				<p class="foot-label">走一走</p>
				<a href="/">记忆墙</a>
				<a href="/blog">归档</a>
					{latest ? (
						<a href={`/blog/${latest.id}/`}>
							文章样本<span class="sr-only">打开最新一篇文章</span>
						</a>
					) : (
						<a href="/blog">
							文章样本<span class="sr-only">暂无文章，打开归档列表</span>
						</a>
					)}
				<a href="/about">关于</a>
			</div>
			<div class="foot-col">
				<p class="foot-label">订阅</p>
				<a href="/rss.xml">RSS Feed<span class="sr-only">订阅本站更新</span></a>
				{/* 无 href 锚点：不可聚焦/不可点击/不播报为链接，与「未开通」一致（终审遗留 #5）。 */}
				<a>邮件订阅 · 未开通</a>
			</div>
		</div>
		<p class="foot-base meta">© 2023–2026 {SITE_TITLE} · 文字与照片均归作者所有</p>
	</div>
</footer>
