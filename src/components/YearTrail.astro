---
import type { Wall } from '../utils/posts';

interface Props {
	wall: Wall;
}

const { wall } = Astro.props;
---

<section class="section" data-od-id="years">
	<div class="container">
		<p class="eyebrow">时间线</p>
		<h2 class="years-title">按年份翻阅</h2>
		<div class="grid-4 year-grid" id="years">
			{
				wall.years.map((group) => (
					<a class="year-cell" href={`/blog/${group.year}/`}>
						<span class="year-num">{group.year}</span>
						<span class="year-meta">{group.count} 张 · {group.categories.join(' · ')}</span>
					</a>
				))
			}
		</div>
		{/* 年份格自分页改造起是链接（docs/pagination-design.md）：点开一年，
		    去归档翻那年的相册页。原 aria-live 联动状态行随之退役。 */}
		<p class="meta years-status">点开一年，翻到那年的相册页。</p>
	</div>
</section>

<style>
	/* 只写布局：两处间距来自原型 home.tpl.html:228/247 的内联样式 */
	.years-title {
		margin-bottom: var(--gap-lg);
	}
	.years-status {
		margin-top: var(--gap-md);
	}
</style>
