---
import { yearPath, type Wall } from '../utils/posts';

interface Props {
	wall: Wall;
}

const { wall } = Astro.props;
// 最新一年的相册由 /blog/ 承载（分页三步），胶片带链接随之特判。
const homeYear = wall.years[0]?.year ?? -1;
---

<section class="section" data-od-id="years">
	<div class="container">
		<p class="eyebrow">时间线</p>
		<h2 class="years-title">按年份翻阅</h2>
		{/* 胶片年份带（docs/pagination-design.md 二步）：横排 mono 刻度，
		    年份跨度大时自动换行、高度可控；与归档总览的大格墙拉开层级。 */}
		<div class="year-strip" id="years">
			{
				wall.years.map((group) => (
					<a class="year-tick" href={yearPath(group.year, homeYear)}>
						<span class="tick-num">{group.year}</span>
						<span class="tick-count">{group.count} 张</span>
					</a>
				))
			}
		</div>
		<p class="meta years-status">点开一年，翻到那年的相册页。</p>
	</div>
</section>

<style>
	/* 只写布局：两处间距来自原型 home.tpl.html:228/247 的内联样式 */
	.years-title {
		margin-bottom: var(--gap-lg);
	}
	.years-status {
		margin-top: var(--gap-md);
	}
</style>
