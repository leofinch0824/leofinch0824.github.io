---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';

// 顶栏（批2，对照 reference/prototype/home.tpl.html:19-33 与 base.css .topnav 段）。
// sticky + 毛玻璃、站名/导航词 white-space:nowrap、760px 收副标与导航间距、
// 560px 撤订阅按钮 —— 全部来自 global.css 的 .topnav 规则，组件内不写颜色。
// 订阅按钮指向 /rss.xml：真实订阅服务未决（PRODUCT.md「明确未决」），RSS 是真链接。
---

<header class="topnav" data-od-id="topnav">
	<div class="container topnav-inner">
		<a class="logo" href="/">
			{SITE_TITLE}<span class="logo-sub">Shiguang</span><span class="sr-only">返回首页</span>
		</a>
		<nav aria-labelledby="site-nav-label">
			<h2 class="sr-only" id="site-nav-label">站点导航</h2>
			<HeaderLink href="/">记忆墙</HeaderLink>
			<HeaderLink href="/blog">归档</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</nav>
		<ThemeToggle />
		<a class="btn btn-secondary" href="/rss.xml">订阅<span class="sr-only">RSS 源</span></a>
	</div>
</header>
