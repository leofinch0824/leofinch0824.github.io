---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import YearAlbum from '../../components/YearAlbum.astro';
import { prepareWall, type WallCard, type YearGroup } from '../../utils/posts';
import { SITE_TITLE } from '../../consts';

// 归档 · 年份相册页（2026-10 分页改造；三步起最新一年由 /blog/ 承载，
// 此路由只为更早的年份生成，docs/pagination-design.md）。
export async function getStaticPaths() {
	const wall = prepareWall(await getCollection('blog'));
	const byYear = new Map<number, WallCard[]>();
	for (const card of wall.cards) {
		const bucket = byYear.get(card.year);
		if (bucket) bucket.push(card);
		else byYear.set(card.year, [card]);
	}
	const homeYear = wall.years[0]?.year;
	// years.slice(1)：跳过最新年（/blog/ 即它的家）。切片后 i 对应原索引 i+1，
	// 原数组上 i 是更近的一年、i+2 是更早的一年；首/末自然为 undefined。
	return wall.years.slice(1).map((group, i) => ({
		params: { year: String(group.year) },
		props: {
			group,
			cards: byYear.get(group.year) ?? [],
			newer: wall.years[i],
			older: wall.years[i + 2],
			allYears: wall.years,
			homeYear,
		},
	}));
}

interface Props {
	group: YearGroup;
	cards: WallCard[];
	newer?: YearGroup;
	older?: YearGroup;
	allYears: YearGroup[];
	homeYear: number;
}

const { group } = Astro.props;
---

<Base
	title={`${group.year} · 归档 · ${SITE_TITLE}`}
	description={`${group.year} 年的 ${group.count} 张相纸：${group.categories.join('、')}。`}
	lang="zh-CN"
>
	<YearAlbum {...Astro.props} />
</Base>
