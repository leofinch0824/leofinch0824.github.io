---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import YearAlbum from '../../components/YearAlbum.astro';
import { prepareWall } from '../../utils/posts';
import { SITE_TITLE } from '../../consts';

// 归档 · 直达最新一年（2026-10 分页三步，docs/pagination-design.md）：
// 点「归档」直接落到当前（最新）年份的相册（所有者拍板：不要「先选年份」的
// 总览态）；年际切换交给页首 year-jump 胶囊。最新一年的路由就是 /blog/ 本身，
// /blog/{最新年}/ 不再生成（避免重复页面）。
const wall = prepareWall(await getCollection('blog'));
const homeGroup = wall.years[0];
---

<Base
	title={`归档 · ${SITE_TITLE}`}
	description={homeGroup ? `${homeGroup.year} 年的 ${homeGroup.count} 张相纸：${homeGroup.categories.join('、')}。` : '按年份翻阅的相册。'}
	lang="zh-CN"
>
	{
		homeGroup ? (
			<YearAlbum
				group={homeGroup}
				cards={wall.cards.filter((card) => card.year === homeGroup.year)}
				allYears={wall.years}
				older={wall.years[1]}
				homeYear={homeGroup.year}
			/>
		) : (
			<main id="content">
				<section class="section intro">
					<div class="container">
						<h1 class="eyebrow">归档</h1>
						<p class="meta">相册还是空的——第一张相纸冲出来后，这里就是它的家。</p>
					</div>
				</section>
			</main>
		)
	}
</Base>
