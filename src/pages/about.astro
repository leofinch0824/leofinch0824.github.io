---
import { Image } from 'astro:assets';
import AboutHeroImage from '../assets/test-pool/portrait.jpg';
import Base from '../layouts/Base.astro';

// 关于页（批4，对照 reference/prototype/about.tpl.html）：
// 脱离 BlogPost 版面、用 Base 独立成页 —— 关于页是双栏 hero + backface + spec，
// 不是文章（迁移方案 §2.1「必须脱离 BlogPost layout」）。
// 人设事实（作者 2026-10-04 提供）：算法工程师，喜欢健身，喜欢看电影；
// 肖像用 docs/images-test/portrait.jpg（拷入 src/assets/test-pool/）。
// 仍待作者提供：名字、坐标、桌上、联系方式邮箱 —— 对应字段保持「待补」占位。
// 「制作说明」只写本仓库当前为真的事实。
---

<Base
	title="关于 · 拾光集"
	description="关于拾光集：为什么写、这个站是怎么搭起来的，以及站在它后面的人。"
	lang="zh-CN"
>
	<style>
		/* 过渡兜底解除（同首页/归档/文章页）：关于页是通栏容器布局。只写布局。 */
		main {
			width: auto;
			max-width: none;
			margin: 0;
			padding: 0;
		}
		/* 原型 about.tpl.html 的三处内联间距，收进布局样式 */
		.why-prose {
			margin-top: var(--gap-lg);
		}
		.why-quote {
			margin-top: var(--gap-xl);
		}
		.facts-title {
			margin-bottom: var(--gap-lg);
		}
	</style>
	<main id="content">
		<section class="section" data-od-id="about-intro">
			<div class="container about-hero">
				<div>
					<p class="eyebrow eyebrow-lead">关于 · 第 01 版</p>
					<h1>关于拾光集，<br class="brk" />和它背后的人。</h1>
					<p class="lead">
						一名算法工程师的暗房：白天和算法打交道，闲下来举铁、看电影。这里把想留下来的东西冲出来、晾干，再贴到墙上——文字也是一种影像记录。
					</p>
					{/* 元信息条：结构照搬 about.tpl.html 的 .intro-meta。
					    已提供的事实如实填写；未提供的字段保持待补（不虚构）。 */}
					<div class="intro-meta">
						<span class="meta">现在 <b class="num">算法工程师</b></span>
						<span class="meta">爱好 <b class="num">健身 · 电影</b></span>
						<span class="meta">坐标 <b class="num">待补</b></span>
					</div>
				</div>
				<div class="wall-item" style="--rot:-0.6deg; --i:0">
					<figure class="print">
						{/* 肖像（作者提供，docs/images-test/portrait.jpg）：
						    layout="none" 只给 width，不裁切（AGENTS.md 硬约束）。 */}
						<Image
							class="print-img"
							src={AboutHeroImage}
							alt="作者的肖像照片"
							width={900}
							layout="none"
							loading="eager"
							fetchpriority="high"
							decoding="async"
						/>
						<figcaption class="print-cap">
							<p class="print-note">作者肖像。</p>
						</figcaption>
					</figure>
				</div>
			</div>
		</section>

		<section class="section" data-od-id="about-why">
			<div class="container">
				<div class="measure">
					<p class="eyebrow">为什么写</p>
					<h2>这里原本只打算放些文字。</h2>
					<div class="prose why-prose">
						<p>
							这个站最初只是想给文字找个存放的地方。写着写着发现，每一篇都被保存成了一张可以回看的快照——什么时候写的、当时在想什么，翻回去都还在。
						</p>
						<p>
							「文字也是一种影像记录」在这里不是比喻。一次记录和一张照片做的是同一件事：把某一刻从时间线上剪下来，钉住。区别只是照片用光，文字用词。
						</p>
						<p>所以这里既有技术笔记，也有生活片段。它们在本站是同一类东西：被保存下来的记忆快照。</p>
					</div>
					<blockquote class="pullquote why-quote">
						写下来的那一刻，它其实已经不是当时了——但至少它还在。
						<p class="pullquote-author">— 关于本站</p>
					</blockquote>
				</div>
			</div>
		</section>

		<section class="section" data-od-id="about-facts">
			<div class="container">
				<div class="measure">
					<p class="eyebrow">照片背面</p>
					<h2 class="facts-title">一些可以写在相纸背面的事实。</h2>
						<div class="backface">
							<div class="backface-row">
								<span class="backface-key">现在</span>
								<p class="backface-val">算法工程师。</p>
							</div>
							<div class="backface-row">
								<span class="backface-key">爱好</span>
								<p class="backface-val">健身，和看电影。举铁与长片轮流占用晚上的时间。</p>
							</div>
							<div class="backface-row">
								<span class="backface-key">名字</span>
								<p class="backface-val">待补。</p>
							</div>
							<div class="backface-row">
								<span class="backface-key">坐标</span>
								<p class="backface-val">待补。</p>
							</div>
							<div class="backface-row">
								<span class="backface-key">更新</span>
								<p class="backface-val">不定期。</p>
							</div>
						</div>
				</div>
			</div>
		</section>

		<section class="section" data-od-id="about-colophon">
			<div class="container">
				<div class="measure">
					<p class="eyebrow">制作说明</p>
					<h2 class="facts-title">这个站是怎么搭的。</h2>
					<div>
						<div class="spec-row">
							<span class="spec-key">框架</span>
							<p class="spec-val">
								<strong>Astro 静态站点。</strong>文章在构建时就生成好 HTML，页面打开即可读，没有等待中的水合过程。
							</p>
						</div>
						<div class="spec-row">
							<span class="spec-key">样式</span>
							<p class="spec-val">
								手写 CSS。一套六个颜色令牌加三条字体栈，没有 UI 框架，也没有运行时样式注入。
							</p>
						</div>
						<div class="spec-row">
							<span class="spec-key">交互</span>
							<p class="spec-val">
								只用少量 TypeScript 处理主题切换、记忆墙展开这类局部状态，其余交给 CSS。没有引入任何组件库运行时。
							</p>
						</div>
						<div class="spec-row">
							<span class="spec-key">公式与代码</span>
							<p class="spec-val">
								代码高亮由 Astro 内置的 Shiki 在构建时完成；数学公式的 KaTeX 方案推荐待验证，尚未接入。
							</p>
						</div>
						<div class="spec-row">
							<span class="spec-key">图片</span>
							<p class="spec-val">
								走 Astro 的资源管线压缩、生成响应式尺寸，首屏之外再延迟加载。
							</p>
						</div>
						<div class="spec-row">
							<span class="spec-key">这一版</span>
							<p class="spec-val">
								是迁移中的正式站。版式与令牌来自「拾光集」原型；页面上的文章与人设均为占位，待真实内容替换。
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="section cta" id="contact" data-od-id="cta-strip">
			<div class="container">
				<h2>想聊点什么？</h2>
				<p class="lead">
					关于技术、照片，或者只是路过打个招呼，都可以写信。联系邮箱目前是占位，待作者提供。
				</p>
				<div class="cta-actions">
					<a class="btn btn-primary" href="mailto:hi@example.com"
						>写信给我<span class="sr-only">跳转邮件客户端（占位邮箱，待作者提供）</span></a
					>
					<a class="btn btn-secondary" href="/rss.xml">RSS Feed</a>
				</div>
			</div>
		</section>
	</main>
</Base>
