---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import MemoryWall from '../components/MemoryWall.astro';
import YearTrail from '../components/YearTrail.astro';
import SubscribeCta from '../components/SubscribeCta.astro';
import { prepareWall, WALL_LIMIT } from '../utils/posts';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// 首页（批3，对照 reference/prototype/home.tpl.html）：
// 卷首（格言式站标 + 元信息条，见 docs/design-polish-2026-10.md 第 2 轮）
// + 记忆墙（橱窗：只渲染最近 WALL_LIMIT 张，docs/pagination-design.md）
// + 年份轨迹（年份链接 → /blog/[year]/）+ 订阅区。
const wall = prepareWall(await getCollection('blog'));
// 墙上只放最近这些张；总量与最早/最新仍按全量算（元信息是全站事实）。
const wallCards = wall.cards.slice(0, WALL_LIMIT);
const total = wall.cards.length;
const latestCard = wall.cards[0];
const earliest = wall.cards[wall.cards.length - 1];
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION} lang="zh-CN">
	<style>
		/* 过渡兜底：global.css 末尾暂留的 main{width:720px}（批2-4 重写完删除）
		   是给旧版 /blog 与文章页的居中列用的；首页是通栏容器布局，这里解除。
		   只写布局，颜色仍全部来自令牌。 */
		main {
			width: auto;
			max-width: none;
			margin: 0;
			padding: 0;
		}
	</style>
	<main id="content">
		<section class="section intro" data-od-id="intro">
			<div class="container">
				{/* 格言式站标（设计精修第 2 轮 #6/#7）：文案出自所有者自述的站点方向，
				    字号降为格言档（--fs-h3），引文行已删。 */}
				<h1>用影像记录生活，用文字表达生活。</h1>
				<div class="intro-meta">
					<span class="meta">
						共 <b class="num">{total}</b> 张
						{total > WALL_LIMIT && (
							<>
								· 墙上留最近 <b class="num">{WALL_LIMIT}</b> 张
							</>
						)}
					</span>
					{earliest && <span class="meta">始于 <b class="num">{earliest.year}</b></span>}
					{latestCard && (
						<span class="meta">
							最近更新 <b class="num"><FormattedDate date={latestCard.post.data.pubDate} /></b>
						</span>
					)}
				</div>
			</div>
		</section>

		<MemoryWall cards={wallCards} />
		<YearTrail wall={wall} />
		<SubscribeCta />
	</main>
</Base>
