---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import MemoryWall from '../components/MemoryWall.astro';
import YearTrail from '../components/YearTrail.astro';
import SubscribeCta from '../components/SubscribeCta.astro';
import { prepareWall } from '../utils/posts';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// 首页（批3，对照 reference/prototype/home.tpl.html）：
// 卷首（Display 衬线，每站一次，北星句在 lead 里）+ 记忆墙 + 年份轨迹 + 订阅区。
// 编号与阅读时长全部构建时算（posts.ts），不进 frontmatter。
const wall = prepareWall(await getCollection('blog'));
// cards 是 WallCard 包装（post/no/minutes/…），条目本体在 .post 里
const latestCard = wall.cards[0];
const earliest = wall.cards[wall.cards.length - 1];
const shown = wall.cards.filter((card) => wall.openYears.includes(card.year)).length;
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION} lang="zh-CN">
	<style>
		/* 过渡兜底：global.css 末尾暂留的 main{width:720px}（批2-4 重写完删除）
		   是给旧版 /blog 与文章页的居中列用的；首页是通栏容器布局，这里解除。
		   只写布局，颜色仍全部来自令牌。 */
		main {
			width: auto;
			max-width: none;
			margin: 0;
			padding: 0;
		}
	</style>
	<main id="content">
		<section class="section intro" data-od-id="intro">
			<div class="container">
				<p class="eyebrow eyebrow-lead">卷首 · 第 01 辑</p>
				<h1>把日子摊开，<br class="brk" />像一叠刚冲出来的照片。</h1>
				<p class="lead">这里存着技术笔记、生活片段，和一些还没想清楚的念头。每一篇都做成一张相纸，按时间贴上去——文字也是一种影像记录。</p>
				<div class="intro-meta">
					<span class="meta">共 <b class="num" id="tally-shown">{shown}</b> / <b class="num">{wall.cards.length}</b> 张</span>
					<span class="meta">始于 <b class="num">{earliest.year}</b></span>
					<span class="meta">最近更新 <b class="num"><FormattedDate date={latestCard.post.data.pubDate} /></b></span>
				</div>
			</div>
		</section>

		<MemoryWall wall={wall} />
		<YearTrail wall={wall} />
		<SubscribeCta />
	</main>
</Base>
